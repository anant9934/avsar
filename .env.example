# AVSAR-owned Neon database. Use pooled URL for the application and direct URL for migrations.
DATABASE_URL=
DATABASE_DIRECT_URL=
# Optional, separate Neon branch for development and Vercel Preview.
# Without this variable, database-backed preview actions stay unavailable.
DATABASE_PREVIEW_URL=
# Optional: non-production local HTTP is supported; production must use HTTPS.
APP_ORIGIN=http://localhost:3000
# Admin provisioning uses all three; ADMIN_TOTP_SECRET is also needed at login.
# Do not use self-registration for admins.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
REPORT_HASH_SECRET=
# Future provider contracts: expected issuer and AVSAR audience only.
# These values alone do not enable linking; verified server adapters are required.
CORE_OIDC_ISSUER=
CORE_OIDC_AUDIENCE=
COLLABORATE_OIDC_ISSUER=
COLLABORATE_OIDC_AUDIENCE=
